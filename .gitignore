.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build output
dist

# Cache
.cache
.parcel-cache

# Clones (worktrees)
clones/

# Autonomous-clone task prompts. A ghost/droid worktree is its own repo root,
# so `clones/` does not cover these — they must be ignored by name or they get
# swept into a commit from inside the worktree (as happened in #226).
.ghost-prompt
.droid-prompt
.explore-plan.md

# Claude Code
.claude/settings.local.json

# Firmware bench secrets (Wi-Fi creds, device id). Arduino resolves
# #include "secrets.h" from the sketch dir, so ignore it anywhere under firmware/.
firmware/secrets.h
firmware/**/secrets.h
firmware/dev/

# Local dev SQLite databases (bench/testing) — match in any directory
dev.db
dev.db-shm
dev.db-wal

# Internal working files — kept locally, deliberately not tracked.
# .tux/  is the product-model tool's state (findings, retrospectives).
# kickstarter-copy.md is unlaunched campaign copy incl. pledge pricing.
.tux/
docs/kickstarter-copy.md
