# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Dependencies
node_modules/

# TypeScript
*.tsbuildinfo
packages/*/dist/

# Environment
.env
.env.*
!.env.example

