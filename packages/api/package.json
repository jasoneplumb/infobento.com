{
  "name": "@infobento/api",
  "version": "0.38.3",
  "description": "InfoBento API: Hono server rendering device framebuffers, plus passkey/OAuth auth and device pairing.",
  "keywords": [
    "infobento",
    "eink",
    "hono",
    "api",
    "webauthn",
    "passkey",
    "typescript"
  ],
  "homepage": "https://www.infobento.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasoneplumb/infobento.com.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/jasoneplumb/infobento.com/issues"
  },
  "author": "Jason E Plumb",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "mint": "node dist/mint-cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@infobento/core": "*",
    "@infobento/data": "*",
    "@infobento/renderer": "*",
    "@simplewebauthn/server": "^13.3.2",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.3",
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
