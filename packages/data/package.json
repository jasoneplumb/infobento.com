{
  "name": "@infobento/data",
  "version": "0.38.2",
  "description": "InfoBento data: pure, edge-safe box-data providers (weather, air quality, quote, …) with caching.",
  "keywords": [
    "infobento",
    "eink",
    "weather",
    "open-meteo",
    "data-providers",
    "typescript"
  ],
  "homepage": "https://www.infobento.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasoneplumb/infobento.com.git",
    "directory": "packages/data"
  },
  "bugs": {
    "url": "https://github.com/jasoneplumb/infobento.com/issues"
  },
  "author": "Jason E Plumb",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./safe-fetch": {
      "node": {
        "types": "./dist/safe-fetch.d.ts",
        "default": "./dist/safe-fetch.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@infobento/core": "*"
  }
}
