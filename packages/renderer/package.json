{
  "name": "@infobento/renderer",
  "version": "0.38.0",
  "description": "InfoBento renderer: 2-bit grayscale eInk framebuffer generation with antialiased TTF text.",
  "keywords": [
    "infobento",
    "eink",
    "epaper",
    "framebuffer",
    "renderer",
    "opentype",
    "typescript"
  ],
  "homepage": "https://www.infobento.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasoneplumb/infobento.com.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://github.com/jasoneplumb/infobento.com/issues"
  },
  "author": "Jason E Plumb",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@infobento/core": "*",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.9",
    "@types/pngjs": "^6.0.5"
  }
}
