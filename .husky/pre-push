echo "Running pre-push checks..."

# Allow skipping all checks
if [ -n "$SKIP_PREPUSH" ]; then
  echo "Skipping pre-push checks (SKIP_PREPUSH set)"
  exit 0
fi

# Check if any source files are included in the push
push_input=$(cat)
source_changed=false
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -qE '\.(ts|tsx|js|jsx)$'; then
    source_changed=true
    break
  fi
done <<< "$push_input"

if [ "$source_changed" = "false" ]; then
  echo "No source files in push — skipping tests and build"
  exit 0
fi

# Run tests
if [ -z "$SKIP_TESTS" ]; then
  echo "Running tests..."
  npm test || {
    echo "Tests failed. Push aborted."
    exit 1
  }
else
  echo "Skipping tests (SKIP_TESTS set)"
fi

# Validate build
echo "Validating build..."
npm run build || {
  echo "Build failed. Push aborted."
  exit 1
}

echo "Pre-push checks passed!"
