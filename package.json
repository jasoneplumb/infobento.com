{
  "name": "infobento.com",
  "version": "0.35.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/post-build.mjs",
    "gen-stickers": "tsx scripts/generate-stickers.ts",
    "typecheck": "tsc -b && npm run typecheck -w @infobento/web",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.20.0",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.24.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "pdfkit": "^0.19.1",
    "prettier": "^3.9.1",
    "qrcode-generator": "^1.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.1.1"
  }
}
